# Kopiere diese Datei nach ".env" und ersetze JEDEN Wert durch einen eigenen, langen Zufallswert.
# Zufallswert erzeugen (Linux/Mac):  openssl rand -hex 32

# Passwort der Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Diesen Schlüssel trägst du in der App unter Einstellungen > Server-Key ein.
NAKAMA_SERVER_KEY=bitte-aendern

# Interne Schlüssel des Servers. Niemals weitergeben.
NAKAMA_SESSION_KEY=bitte-aendern
NAKAMA_REFRESH_KEY=bitte-aendern
NAKAMA_HTTP_KEY=bitte-aendern

# Login der Verwaltungsoberfläche (nur lokal auf dem Server erreichbar, Port 7351)
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=bitte-aendern
